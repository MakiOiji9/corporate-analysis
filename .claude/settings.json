{
  "permissions": {
    "allow": [
      "Read(.ai/**)",
      "Read(企業分析フレームワーク.md)",
      "Read(market/**)",
      "Read(companies/**)",
      "Write(market/sessions/**)",
      "Write(companies/**)",
      "Edit(companies/**)",
      "Edit(market/sessions/**)",
      "Edit(market/policy/**)",
      "Edit(market/report/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/tools/guard/write_guard.py\""
          }
        ]
      }
    ]
  }
}
