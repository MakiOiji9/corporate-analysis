# Python
.venv/
__pycache__/
*.pyc

# Secrets
.env

# Tool caches (EDINET daily lists etc.)
.cache/

# Lock / temp files of tools/collect (parallel sub-agents)
*.lock
*.tmp

# Original documents downloaded by tools/collect/fetch.py.
# Only the manifest is committed; originals can be re-fetched from its URLs.
companies/*/sources/**
!companies/*/sources/
!companies/*/sources/manifest.csv

# Same for collect-market-info (policy library and sessions)
market/**/sources/**
!market/**/sources/
!market/**/sources/manifest.csv

# The writer's JSON poured into an analysis / report md by the `fill` subcommand (the md keeps the text)
companies/*/analysis/*/*_fills.json
companies/*/reports/*_fills.json

# Run state of collect-market-info (running marker for the write guard, git baseline)
market/sessions/*/.running
market/sessions/*/.baseline.json
