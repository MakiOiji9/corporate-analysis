# Python
.venv/
__pycache__/
*.pyc

# Secrets
.env

# Tool caches (EDINET daily lists etc.)
.cache/

# Lock / temp files of tools/collect (parallel sub-agents)
*.lock
*.tmp

# Original documents downloaded by tools/collect (fetch.py, edinet.py, market/docs.py) are kept in git with
# their manifest (policy of 2026-11-23). Not kept: a file above 20MB (saved under sources/_large/, the manifest
# note says so), the folder an XBRL->CSV zip is extracted to (the zip is kept), and files moved aside by
# sources_admin.py remove.
companies/*/sources/**/_large/
companies/*/sources/**/*_csv/
companies/*/sources/_removed/
market/**/sources/**/_large/
market/**/sources/_removed/

# The writer's JSON poured into an analysis / report md by the `fill` subcommand (the md keeps the text)
companies/*/analysis/*/*_fills.json
companies/*/reports/*_fills.json

# Run state of collect-market-info (running marker for the write guard, git baseline)
market/sessions/*/.running
market/sessions/*/.baseline.json
